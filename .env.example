NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=nexoria
DB_PASSWORD=***
DB_NAME=nexoria

REDIS_URL=redis://localhost:6379

JWT_SECRET=change...tion
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=***
OPENROUTER_API_KEY=***

# Default runtime model provider for the built-in orchestrator
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_MODEL_NAME=gpt-oss:120b

# Ollama Cloud direct API access
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# Camofox browser automation (internal Docker network)
CAMOFOX_URL=http://camofox:9377
CAMOFOX_ACCESS_KEY=dev-camofox-key-change-me

# Managed OpenClaw runtime (internal Docker network)
NEXORIA_RUNNER_TOKEN=dev-runner-token-change-me
NEXORIA_RUNNER_INSTANCE_KEY=local-openclaw-runner
OPENCLAW_GATEWAY_TOKEN=dev-openclaw-token-change-me
OPENCLAW_MODEL=openclaw
RUNNER_POLL_MS=2500
RUNNER_HEARTBEAT_MS=15000

# S3-compatible object storage. Local Docker uses MinIO.
MINIO_ROOT_USER=nexoria
MINIO_ROOT_PASSWORD=nexoria-minio-secret
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexoria-artifacts
S3_ACCESS_KEY_ID=nexoria
S3_SECRET_ACCESS_KEY=nexoria-minio-secret
S3_FORCE_PATH_STYLE=true

# Pro Agent remote runtime (optional; enable with --profile pro)
NEXORIA_PRO_AGENT_TOKEN=dev-pro-agent-token-change-me
NEXORIA_PRO_AGENT_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
NEXORIA_PRO_AGENT_PROFILE_ID=00000000-0000-0000-0000-000000000000
PRO_AGENT_LLM_PROVIDER=openai
PRO_AGENT_LLM_API_KEY=your-openai-api-key
PRO_AGENT_LLM_MODEL=gpt-4o
# PROXY_STRATEGY=backconnect
# PROXY_BACKCONNECT_HOST=
# PROXY_BACKCONNECT_PORT=7000
# PROXY_USERNAME=
# PROXY_PASSWORD=
