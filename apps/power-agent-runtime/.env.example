# Nexoria Power Agent Runtime Environment

# Nexoria API
NEXORIA_API_URL=http://api:3000/api/v1
NEXORIA_RUNNER_TOKEN=dev-runner-token
NEXORIA_INSTANCE_KEY=power-agent-local
NEXORIA_USER_ID=power-user
NEXORIA_WORKSPACE_ID=default
NEXORIA_AGENT_ID=power-agent-1

# Hub WebSocket URL (Nexoria API)
NEXORIA_HUB_URL=ws://api:3000/agent-hub/v1

# LLM Provider API Keys
# At least one must be configured
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# Ollama Base URL (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Data directories
NEXORIA_DATA_DIR=/var/nexoria/data
NEXORIA_SKILLS_DIR=/var/nexoria/skills
NEXORIA_TOOLS_DIR=/var/nexoria/tools
